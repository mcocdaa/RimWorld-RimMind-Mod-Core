<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RimMind.Tests</RootNamespace>
    <AssemblyName>RimMindCore.Tests</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <DormantTest Include="AgentGoalStackTests.cs" Reason="Targets SerializableAgentGoalStack, a Verse-backed pre-composition persistence wrapper not compiled into the pure test target." />
    <DormantTest Include="AIRequestQueueCancellationTokenTests.cs" Reason="Targets removed AIRequest/AIResponse queue contracts; migrate to LlmRequestEnvelope queue tests." />
    <DormantTest Include="ApiContractHardenTests.cs" Reason="Targets retired AIResponse, HistoryManager, ProviderRegistry, and StrategyOptimizer APIs." />
    <DormantTest Include="ArchitectureOptimizationTests.cs" Reason="Targets the retired AIRequestPool and pre-runtime composition APIs." />
    <DormantTest Include="BudgetSchedulerTests.cs" Reason="Targets the retired static RelevanceTable; current scheduler coverage uses IRelevanceTable." />
    <DormantTest Include="ContextEngineTests.cs" Reason="Targets retired ContextEngine and ContextRequest types; migrate assertions to ContextOrchestrator." />
    <DormantTest Include="ContextEntryQueryTests.cs" Reason="Targets the retired ContextEntryQuery API." />
    <DormantTest Include="DataFlowSideEffectTests.cs" Reason="Partially targets the retired ContextEntryQuery API; split current data-flow assertions before re-enabling." />
    <DormantTest Include="ErrorBoundaryTests.cs" Reason="Targets the retired TransientExceptionChecker and old error factory signatures." />
    <DormantTest Include="LifecycleSafetyTests.cs" Reason="Targets retired ContextEngine lifecycle; replace with current runtime/context ownership tests." />
    <DormantTest Include="ToolCallDispatchMiddlewareTests.cs" Reason="Targets retired Pipeline.AI middleware and AIRequest contracts; unified pipeline coverage lives under Pipeline/Unified." />
    <DormantTest Include="FlywheelRuleEngineTests.cs" Reason="Targets retired TelemetryRecord contract; migrate to current flywheel domain record." />
    <DormantTest Include="FlywheelTelemetryCollectorTests.cs" Reason="Targets retired TelemetryRecord contract; migrate to current telemetry API." />
    <DormantTest Include="NpcManagerTests.cs" Reason="Requires the Verse NpcManager adapter, which is not compiled into the pure net10 test target." />
    <DormantTest Include="PerceptionBridgeTests.cs" Reason="Targets the retired Presentation.Perception namespace." />
    <DormantTest Include="RimMindLoggerTests.cs" Reason="Targets the retired Application.Features.Logging namespace and an obsolete ILogSink shape." />
    <DormantTest Include="PawnActorTests.cs" Reason="Targets the pre-composition PawnAgent runtime fixture." />
    <DormantTest Include="PawnAgentTests.cs" Reason="Targets the pre-composition PawnAgent and RimMindCoreSettings runtime fixture." />
    <DormantTest Include="PawnPerceiverTests.cs" Reason="Targets the pre-composition PawnAgent runtime fixture." />
    <DormantTest Include="PawnRecorderTests.cs" Reason="Targets the pre-composition PawnAgent runtime fixture." />
    <DormantTest Include="PawnThinkerTests.cs" Reason="Targets the pre-composition PawnAgent runtime fixture." />
    <DormantTest Include="MentalStateRecoveryTests.cs" Reason="Targets the pre-composition PawnAgent/NpcManager runtime fixture." />
    <DormantTest Include="PublishDecisionJobEnqueueTests.cs" Reason="Targets retired Infrastructure.Patches and the pre-composition PawnAgent fixture." />
    <DormantTest Include="PromptSectionTests.cs" Reason="Targets retired PromptSection trimming semantics and priority constants." />
    <DormantTest Include="RelevanceTableTests.cs" Reason="Targets the retired static RelevanceTable; current coverage uses RelevanceTableImpl." />
    <DormantTest Include="RimMindRuntimeTests.cs" Reason="Targets the retired static RimMindRuntime.Instance/ResetInstance composition API." />
    <DormantTest Include="SettingsDefaultsTests.cs" Reason="Requires Verse-backed settings types not compiled into the pure test target." />
    <DormantTest Include="StrategyOptimizerTests.cs" Reason="Targets the Verse-backed pre-composition StrategyOptimizer fixture." />
    <DormantTest Include="ThinkNodeRimMindAgentTests.cs" Reason="Targets retired Infrastructure.Patches and the pre-composition PawnAgent fixture." />
    <DormantTest Include="Pipeline\LoggerTraceIdTests.cs" Reason="Targets the retired RimMindLogger trace-scope implementation." />
    <DormantTest Include="Pipeline\PipelineCoreTests.cs" Reason="Targets the retired mutable generic pipeline API; current coverage lives under Pipeline/Unified." />
    <DormantTest Include="Pipeline\AI\AIRequestPipelineTests.cs" Reason="Targets retired AIRequest/AIResponse pipeline contexts; migrate relevant behavior to Pipeline/Unified." />
    <DormantTest Include="Pipeline\Bus\BusPublishPipelineTests.cs" Reason="Targets the retired bus middleware pipeline; current AgentBus coverage exercises direct subscriber isolation." />
    <DormantTest Include="Pipeline\Context\ContextBuildPipelineTests.cs" Reason="Targets the retired ContextBuildContext pipeline; current context coverage uses ContextOrchestrator and unified middleware." />
    <DormantTest Include="Pipeline\Npc\NpcChatPipelineTests.cs" Reason="Targets the retired NpcChatContext pipeline; current request coverage uses LlmRequestEnvelope and unified middleware." />
  </ItemGroup>

