<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RimMind.Core.Tests</RootNamespace>
    <AssemblyName>RimMindCore.Tests</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="VerseStubs.cs" />
    <Compile Include="RimMindTestStubs.cs" />
    <Compile Include="**\*.cs" Exclude="VerseStubs.cs;RimMindTestStubs.cs;obj\**\*.cs" />
    <Compile Include="../Source/Contracts/**/*.cs" Exclude="../Source/Contracts/**/obj/**;../Source/Contracts/Compilers/IsExternalInit.cs" />
    <Compile Include="../Source/Kernel/**/*.cs" Exclude="../Source/Kernel/**/obj/**;../Source/Kernel/Flywheel/FlywheelBuiltinTuner.cs;../Source/Kernel/Llm/ResponseDispatcher.cs" />
    <Compile Include="../Source/Adapters/Client/HttpHelper.cs" />
    <Compile Include="../Source/Adapters/Client/OpenAI/*.cs" />
    <Compile Include="../Source/Adapters/Client/Player2/*.cs" />
    <Compile Include="../Source/Core/Agent/**/*.cs" />
    <Compile Include="../Source/Core/Perception/**/*.cs" />
    <Compile Include="../Source/Core/Registry/**/*.cs" />
    <Compile Include="../Source/Core/Sensor/ISensorProvider.cs" />
    <Compile Include="../Source/Core/Sensor/SensorManager.cs" />
    <Compile Include="../Source/Compilers/**/*.cs" />
    <Compile Include="../Source/Comps/**/*.cs" />
    <Compile Include="../Source/Adapters/Verse/AIRequestQueueGameComponent.cs" />
    <Compile Include="../Source/Adapters/Verse/AgentBusGameComponent.cs" />
    <Compile Include="../Source/Adapters/Verse/CompPawnAgent.cs" />
    <Compile Include="../Source/Adapters/Verse/NpcManager.cs" />
    <Compile Include="../Source/Settings/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="../Source/Adapters/Client/Player2/Player2Client.cs" />
    <Compile Remove="../Source/Core/Registry/OverlayService.cs" />
    <Compile Remove="../Source/Core/Registry/ClientManager.cs" />
    <Compile Remove="../Source/Core/Agent/PerceptionPipeline.cs" />
    <Compile Remove="../Source/Core/Agent/NpcProfileBuilder.cs" />
    <Compile Remove="../Source/Core/Runtime/RimMindRuntime.cs" />
    <Compile Remove="../Source/Settings/RimMindCoreSettingsUI.cs" />
    <Compile Remove="../Source/Adapters/Client/HttpHelper.cs" />
    <Compile Remove="../Source/Core/Sensor/SensorManager.cs" />
    <Compile Remove="../Source/Core/GameContextBuilder.cs" />
    <Compile Remove="../Source/Core/PawnDataExtractor.cs" />
    <Compile Remove="../Source/Core/ThreatClassifier.cs" />
  </ItemGroup>

</Project>
