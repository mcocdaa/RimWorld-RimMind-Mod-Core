  <ItemGroup>
    <TestSourceCandidate Include="**\*Tests.cs" Exclude="bin\**;obj\**;_backup\**" />
    <UnclassifiedTest Include="@(TestSourceCandidate)" Exclude="@(Compile);@(DormantTest)" />
  </ItemGroup>

  <Target Name="ValidateTestSourcePartition" BeforeTargets="CoreCompile">
    <Error Condition="'@(UnclassifiedTest)' != ''"
           Text="Test source files must be compiled or explicitly declared as DormantTest: @(UnclassifiedTest)" />
    <Error Condition="'%(DormantTest.Reason)' == ''"
           Text="Dormant test '%(DormantTest.Identity)' must include a non-empty Reason." />
    <Error Condition="!Exists('%(DormantTest.FullPath)')"
           Text="Dormant test '%(DormantTest.Identity)' does not exist." />
    <Message Importance="High"
             Text="RimMind Core test partition: @(Compile->Count()) compiled items, @(DormantTest->Count()) documented dormant tests." />
  </Target>

</Project>
