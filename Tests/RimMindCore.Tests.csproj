<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RimMind.Tests</RootNamespace>
    <AssemblyName>RimMindCore.Tests</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="VerseStubs.cs" />
    <Compile Include="RimMindTestStubs.cs" />
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="MockAIClient.cs" />
    <Compile Include="**\*.cs" Exclude="VerseStubs.cs;RimMindTestStubs.cs;GlobalUsings.cs;MockAIClient.cs;obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Source/Domain/**/*.cs" Exclude="../Source/Domain/**/obj/**" />
    <Compile Include="../Source/Application/**/*.cs" Exclude="../Source/Application/**/obj/**;../Source/Application/DependencyInjection.cs" />
    <Compile Include="../Source/Infrastructure/**/*.cs" Exclude="../Source/Infrastructure/**/obj/**;../Source/Infrastructure/DependencyInjection.cs;../Source/Infrastructure/UI/AICoreDebugActions.cs" />
    <Compile Include="../Source/Presentation/**/*.cs" Exclude="../Source/Presentation/**/obj/**;../Source/Presentation/Agent/GameContextBuilder.cs" />
    <Compile Include="../Source/AICoreMod.cs" />
    <Compile Include="../Source/RimMindAPI.cs" />
  </ItemGroup>

</Project>
