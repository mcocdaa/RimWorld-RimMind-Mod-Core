<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RimMind.Domain</RootNamespace>
    <AssemblyName>0_RimMindDomain</AssemblyName>
    <Version>2.0.0</Version>
    <OutputPath>..\..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="1_RimMindApplication" />
    <InternalsVisibleTo Include="2_RimMindCore" />
    <InternalsVisibleTo Include="RimMindTest" />
  </ItemGroup>

</Project>
