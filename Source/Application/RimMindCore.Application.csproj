<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RimMind.Application</RootNamespace>
    <AssemblyName>1_RimMindApplication</AssemblyName>
    <Version>2.0.0</Version>
    <OutputPath>..\..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\RimMindCore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="2_RimMindCore" />
    <InternalsVisibleTo Include="RimMindTest" />
    <InternalsVisibleTo Include="RimMindCore.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Features\Agent\Modes\**" />
    <Compile Remove="Common\Interfaces\Agent\Modes\**" />
  </ItemGroup>

</Project>
