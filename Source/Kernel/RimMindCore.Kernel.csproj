<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RimMind.Kernel</RootNamespace>
    <AssemblyName>1_RimMindKernel</AssemblyName>
    <Version>2.0.0</Version>
    <OutputPath>..\..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\RimMindCore.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="2_RimMindCore" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Context\BudgetSchedulerConfig.cs" />
    <Compile Remove="Flywheel\AnalysisReportRecord.cs" />
    <Compile Remove="Flywheel\FlywheelAutoApplyMode.cs" />
    <Compile Remove="Context\ContextEntry.cs" />
    <Compile Remove="Prompt\PromptSection.cs" />
    <Compile Remove="Pipeline\AI\ShortCircuitMiddleware.cs" />
    <Compile Remove="Pipeline\AI\AIRequestPipelineFactory.cs" />
    <Compile Remove="Pipeline\AI\CircuitBreakerMiddleware.cs" />
    <Compile Remove="Pipeline\Context\BudgetTrimMiddleware.cs" />
    <Compile Remove="Pipeline\Context\ContextBuildPipelineFactory.cs" />
    <Compile Remove="Pipeline\Npc\NpcAliveCheckMiddleware.cs" />
    <Compile Remove="Pipeline\Npc\StorageDriverInvokeMiddleware.cs" />
    <Compile Remove="Pipeline\Npc\NpcChatPipelineFactory.cs" />
    <Compile Remove="Llm\ResponseDispatcher.cs" />
    <Compile Remove="Npc\StorageDriverFactory.cs" />
    <Compile Remove="Npc\LocalStorageDriver.cs" />
  </ItemGroup>

</Project>
