<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RimMind.Contracts</RootNamespace>
    <AssemblyName>0_RimMindContracts</AssemblyName>
    <Version>2.0.0</Version>
    <OutputPath>..\..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Extension\ISettingsTab.cs" />
    <Compile Remove="Extensions\IAgentActionBridge.cs" />
    <Compile Remove="Extensions\IParameterTuner.cs" />
    <Compile Remove="Internal\IAIDebugLog.cs" />
    <Compile Remove="Internal\IClientManager.cs" />
    <Compile Remove="Internal\IProviderRegistry.cs" />
    <Compile Remove="UI\IAudioPlayer.cs" />
  </ItemGroup>

</Project>
