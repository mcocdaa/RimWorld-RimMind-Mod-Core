<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RimMind.Core</RootNamespace>
    <AssemblyName>2_RimMindCore</AssemblyName>
    <Version>2.0.0</Version>
    <OutputPath>..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include=".\Contracts\RimMindCore.Contracts.csproj" />
    <ProjectReference Include=".\Kernel\RimMindCore.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" PrivateAssets="All" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AICoreMod.cs" />
    <Compile Include="RimMindAPI.cs" />
    <Compile Include="Adapters\**\*.cs" />
    <Compile Include="Client\**\*.cs" />
    <Compile Include="Comps\**\*.cs" />
    <Compile Include="Compilers\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Debug\**\*.cs" />
    <Compile Include="Npc\**\*.cs" />
    <Compile Include="Settings\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Client\AIRequest.cs" />
    <Compile Remove="Client\AIResponse.cs" />
    <Compile Remove="Client\IAIClient.cs" />
    <Compile Remove="Client\StructuredTool.cs" />
    <Compile Remove="Core\AIProvider.cs" />
    <Compile Remove="Core\Extension\ISettingsTab.cs" />
    <Compile Remove="Core\Sensor\ISensorManager.cs" />
    <Compile Remove="Npc\NpcTypes.cs" />
    <Compile Remove="Core\Internal\IClientManager.cs" />
    <Compile Remove="Core\Internal\IProviderRegistry.cs" />
    <Compile Remove="Core\Extensions\IAgentActionBridge.cs" />
    <Compile Remove="Core\Extensions\IParameterTuner.cs" />
    <Compile Remove="Core\Internal\IAIDebugLog.cs" />
    <Compile Remove="Core\Internal\IAIRequestQueue.cs" />
    <Compile Remove="Core\Internal\RimMindServiceLocator.cs" />
    <Compile Remove="Core\UI\IAudioPlayer.cs" />
    <Compile Remove="Core\Internal\TrackedRequest.cs" />
    <Compile Remove="Npc\INpcManager.cs" />
    <Compile Remove="Core\AgentBus\IEventBus.cs" />
    <Compile Remove="Core\AgentBus\Events\PerceptionEvent.cs" />
    <Compile Remove="Core\AgentBus\Events\ActionEvent.cs" />
    <Compile Remove="Core\AgentBus\Events\DecisionEvent.cs" />
    <Compile Remove="Core\Flywheel\IFlywheelParameterStore.cs" />
  </ItemGroup>

</Project>
