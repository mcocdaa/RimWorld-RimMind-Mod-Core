<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RimMind.Core</RootNamespace>
    <AssemblyName>2_RimMindCore</AssemblyName>
    <Version>2.0.0</Version>
    <OutputPath>..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include=".\Contracts\RimMindCore.Contracts.csproj" />
    <ProjectReference Include=".\Kernel\RimMindCore.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" PrivateAssets="All" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AICoreMod.cs" />
    <Compile Include="RimMindAPI.cs" />
    <Compile Include="Adapters\**\*.cs" />
    <Compile Include="Compilers\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Npc\**\*.cs" />
    <Compile Include="Kernel\Pipeline\AI\ShortCircuitMiddleware.cs" />
    <Compile Include="Kernel\Pipeline\AI\AIRequestPipelineFactory.cs" />
    <Compile Include="Kernel\Pipeline\AI\CircuitBreakerMiddleware.cs" />
    <Compile Include="Kernel\Pipeline\Context\BudgetTrimMiddleware.cs" />
    <Compile Include="Kernel\Pipeline\Context\ContextBuildPipelineFactory.cs" />
    <Compile Include="Kernel\Pipeline\Npc\NpcAliveCheckMiddleware.cs" />
    <Compile Include="Kernel\Pipeline\Npc\StorageDriverInvokeMiddleware.cs" />
    <Compile Include="Kernel\Pipeline\Npc\NpcChatPipelineFactory.cs" />
    <Compile Include="Infrastructure\**\*.cs" />
    <Compile Include="Kernel\Llm\ResponseDispatcher.cs" />
    <Compile Include="Kernel\Npc\StorageDriverFactory.cs" />
    <Compile Include="Kernel\Npc\LocalStorageDriver.cs" />
  </ItemGroup>

</Project>
