<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RimMind.Core</RootNamespace>
    <AssemblyName>2_RimMindCore</AssemblyName>
    <Version>2.0.0</Version>
    <OutputPath>..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include=".\Contracts\RimMindCore.Contracts.csproj" />
    <ProjectReference Include=".\Kernel\RimMindCore.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AICoreMod.cs" />
    <Compile Include="RimMindAPI.cs" />
    <Compile Include="Adapters\**\*.cs" />
    <Compile Include="Client\**\*.cs" />
    <Compile Include="Comps\**\*.cs" />
    <Compile Include="Compilers\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Debug\**\*.cs" />
    <Compile Include="Npc\**\*.cs" />
    <Compile Include="Settings\**\*.cs" />
  </ItemGroup>

</Project>
