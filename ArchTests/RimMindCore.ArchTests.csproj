<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RimMind.Core.ArchTests</RootNamespace>
    <AssemblyName>RimMindCore.ArchTests</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ArchTestExtensions.cs" />
    <Compile Include="PhaseA\**\*.cs" />
    <Compile Include="PhaseB\**\*.cs" />
    <Compile Include="PhaseC\**\*.cs" />
    <Compile Include="PhaseD\**\*.cs" />
    <Compile Include="PhaseE\**\*.cs" />
    <Compile Include="PhaseG\**\*.cs" />
    <Compile Include="PhaseJ\**\*.cs" />
    <Compile Include="PhaseK\**\*.cs" />
    <Compile Include="PhaseL\**\*.cs" />
    <Compile Include="PhaseH1\**\*.cs" />
    <Compile Include="PhaseH2\**\*.cs" />
    <Compile Include="PhaseI\**\*.cs" />
    <Compile Remove="PhaseI\R_I1_I4_AgentModeArchTests.cs" />
    <Compile Include="PhaseStructure\**\*.cs" />
    <Compile Include="General\**\*.cs" />
    <Compile Include="../Tests/VerseStubs.cs" Link="VerseStubs.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source\Domain\RimMindCore.Domain.csproj" />
    <ProjectReference Include="..\Source\Application\RimMindCore.Application.csproj" />
    <ProjectReference Include="..\Source\RimMindCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
